# ─── Variables de entorno del backend ───────────────────────
# Copiá este archivo como ".env" para desarrollo local.
# En local NO necesitás DATABASE_URL: sin ella, se usa SQLite.

# Puerto del servidor (Render lo setea solo en producción)
PORT=5000

# Secreto para firmar los tokens JWT (en producción lo genera Render)
JWT_SECRET=cambiar_esto_en_local_por_algo_cualquiera

# URL del frontend permitida por CORS (en local no hace falta)
# FRONTEND_URL=https://silvia-frontend.onrender.com

# Base PostgreSQL. Si está definida, el backend usa Postgres.
# Si NO está (local), usa SQLite automáticamente.
# DATABASE_URL=postgresql://user:pass@host:5432/silvia
